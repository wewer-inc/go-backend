# ---- App ----
APP_ENV=dev
APP_PORT=8080
APP_LOG_LEVEL=debug

# ---- Ready / timeout checks ----
DB_CONTEXT_TIMEOUT=2s
READY_CHECK_TIMEOUT=3s

# ---- HTTP hardening ----
HTTP_MAX_BODY_BYTES=1048576    # 1 MiB request body cap (0 disables)
HTTP_MAX_HEADER_BYTES=1048576  # 1 MiB request header cap
# Comma-separated trusted reverse-proxy IPs/CIDRs. Leave empty unless behind a
# proxy/LB — only then is X-Forwarded-For honoured for client IP / rate limiting.
TRUSTED_PROXIES=

# ---- Database ----
# NOTE: sslmode=disable is for local only. Use sslmode=require / verify-full in prod.
DB_DSN=postgres://YOUR_APP_NAME:YOUR_APP_NAME@postgres:5432/YOUR_APP_NAME?sslmode=disable
# Run migrations explicitly in prod (e.g. a job/step), not on every replica boot.
DB_MIGRATE_ON_START=false
DB_MAX_OPEN=10
DB_MAX_IDLE=5
DB_CONN_LIFETIME=1h
DB_CONN_IDLE_TIME=10m
DB_SLOW_THRESHOLD=200ms
# Log parameter values in slow and failed query logs. Keep false wherever real personal data exists.
DB_LOG_QUERY_VALUES=false

# ---- S3 / Object Storage ----
# Off by default — set S3_ENABLED=true and fill the fields below to wire it up.
S3_ENABLED=false
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_USE_PATH_STYLE=false
S3_PRESIGN_UPLOAD_TTL=900s
S3_PRESIGN_DOWNLOAD_TTL=900s
S3_MAX_OBJ_MB=25
S3_ALLOWED_MIMES=image/jpeg,image/png,image/webp
S3_BASE_PREFIX=

# ---- Redis ----
# Rate limiting and the access-token denylist. Sessions live in Postgres, so auth
# works with Redis disabled, but its public endpoints then have no rate limit.
REDIS_ENABLED=true
REDIS_ADDR=redis:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS_ENABLE=false
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE=2
REDIS_DIAL_TIMEOUT_MS=500ms
REDIS_READ_TIMEOUT_MS=500ms
REDIS_WRITE_TIMEOUT_MS=500ms

# ---- JWT ----
# Use a long (>=32 byte) random secret in every non-dev environment.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ISSUER=YOUR_APP_NAME
JWT_AUDIENCE=YOUR_APP_NAME
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# ---- Auth ----
# When Redis (the access-token denylist) is unreachable: false = reject requests
# (503, favours revocation guarantees), true = accept (favours availability).
AUTH_REVOCATION_FAIL_OPEN=false
# Hard cap on a session. Refreshing extends JWT_REFRESH_EXPIRY up to this and no further.
SESSION_ABSOLUTE_TTL=720h
# How long after a rotation the previous refresh token counts as a concurrent request
# (409 refresh_retry, session kept) rather than a replay (session revoked).
REFRESH_RACE_WINDOW=30s
# Failed sign-ins per address before it locks until the window ends. 0 disables lockout.
# Held in Postgres, so it works with Redis disabled.
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_WINDOW=15m

# ---- Password reset and reuse ----
# The page in your client that takes the emailed ?token= and posts it to
# /v1/auth/reset-password. Reset emails are not sent while this is empty.
PASSWORD_RESET_URL=http://localhost:3000/reset-password
PASSWORD_RESET_TTL=1h
# After sending a reset email, wait this long before an account can get another.
PASSWORD_RESET_COOLDOWN=2m
# How many previous passwords a new one must differ from. 0 checks only the current one.
PASSWORD_HISTORY_COUNT=3

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/v1/auth/google/callback

# ---- SMTP / Email ----
# SMTP_MODE: starttls (port 587, default) | implicit_tls (port 465) | plain
# (no encryption, dev only — never authenticates and is rejected in prod).
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_PASSWORD=
SMTP_MODE=starttls

# ---- CORS ----
# Comma-separated list of allowed origins. Use * to allow all (dev only).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Rate Limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TRUST_PROXY=false
RATE_LIMIT_GLOBAL_RPM=60
RATE_LIMIT_GLOBAL_BURST=30
RATE_LIMIT_ADMIN_RPM=30
RATE_LIMIT_ADMIN_BURST=10
RATE_LIMIT_AUTH_RPM=10
RATE_LIMIT_AUTH_BURST=5
